# Copy to `.env` (gitignored) for local runs. On a pod set these as the pod's
# environment variables instead — a file inside the container is lost with it.

# Bearer token for every /api call. A pod's proxy URL is public; set this.
#   openssl rand -hex 16
OVS_AUTH_TOKEN=

# Root for voices/, outputs/, hf-cache/ and ovs.db.
# Defaults to /workspace when it exists (RunPod), else ./data.
# OVS_DATA_DIR=/workspace

# OVS_MODEL_ID=k2-fsa/OmniVoice
# OVS_DEVICE=cuda:0
# OVS_WHISPER_MODEL=small
# OVS_PORT=8000
