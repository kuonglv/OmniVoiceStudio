# CPU-only image for working on the API and the UI.
#
# No CUDA, no torch, no `omnivoice` — synthesis fails here with the "not
# installed" error on purpose. Everything else (voice library, uploads, jobs,
# the log stream, downloads) is the real code path. It builds in seconds and
# runs on an Apple-silicon Mac, which the CUDA image does not.
FROM python:3.11-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY ovs/ ./ovs/
COPY voices_seed/ ./voices_seed/

ENV OVS_DATA_DIR=/data \
    OVS_DEVICE=cpu \
    PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["uvicorn", "ovs.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
